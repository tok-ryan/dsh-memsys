{
  "name": "dsh-memsys",
  "version": "0.1.0",
  "description": "A memory system plugin for DeepSeek Harness: append-only facts, candidates and adjudication, dreams, and budget-aware context injection.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tok-ryan/dsh-memsys.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "memory",
    "sqlite",
    "agent"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": "./index.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "src",
    "scripts",
    "test"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "migrate": "node scripts/migrate.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
